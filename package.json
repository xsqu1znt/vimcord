{
    "name": "vimcord-monorepo",
    "private": true,
    "scripts": {
        "build": "pnpm -r build",
        "format": "pnpm -r format && prettier --write \"scripts/**/*.ts\" \"vitest.config.ts\" \"package.json\" \"tsconfig.json\"",
        "check": "pnpm -r check && tsc --noEmit -p tsconfig.json",
        "publish:workspace": "tsx scripts/publishWorkspace.ts"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.8.0",
        "prettier": "^3.8.3",
        "tsup": "^8.5.1",
        "tsx": "^4.22.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.6"
    }
}
