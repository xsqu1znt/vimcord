{
    "name": "vimcord-monorepo",
    "private": true,
    "scripts": {
        "build": "pnpm -r build",
        "format": "pnpm -r format && prettier --write \"vitest.config.ts\" \"package.json\" \"tsconfig.json\"",
        "check": "pnpm -r check && tsc --noEmit -p tsconfig.json",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.8.0",
        "prettier": "^3.8.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.6"
    }
}
