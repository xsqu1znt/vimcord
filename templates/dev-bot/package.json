{
    "name": "dev-bot",
    "version": "0.1.0",
    "main": "index.js",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "start": "node dist/index.js",
        "start:verbose": "node dist/index.js --verbose",
        "dev": "nodemon --exec \"tsx src/index.ts --dev\" -w src -w config -e \"json ts\"",
        "dev:verbose": "nodemon --exec \"tsx src/index.ts --dev --verbose\" -w src -w config -e \"json ts\"",
        "build": "tsc && tsc-alias",
        "check": "tsc --noEmit",
        "format": "prettier --write \"./**/*.{ts,json}\""
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.5.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "dependencies": {
        "@vimcord/plugin-dotenv": "workspace:*",
        "discord.js": "^14.26.3",
        "vimcord": "workspace:*"
    }
}
