{
    "name": "vimcord",
    "version": "2.0.0",
    "description": "A powerful and opinionated Discord.js wrapper.",
    "author": "xsqu1znt",
    "license": "MIT",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "type": "module",
    "scripts": {
        "build": "tsup",
        "check": "tsc --noEmit",
        "format": "prettier --write \"./**/*.{ts,json}\""
    },
    "dependencies": {
        "@vimcord/core": "workspace:*"
    }
}
